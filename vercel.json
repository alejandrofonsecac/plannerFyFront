{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api", "destination": "https://api-workspace-vmky.onrender.com/" },
    { "source": "/api/:path*", "destination": "https://api-workspace-vmky.onrender.com/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}